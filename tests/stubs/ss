#!/bin/bash
# ss 测试桩：4 条监听记录，覆盖 tcp/udp 与不同端口。
printf 'ss %s\n' "$*" >> "${STUB_LOG:-/dev/null}"
cat <<'EOF'
Netid  State   Recv-Q  Send-Q      Local Address:Port   Peer Address:Port  Process
tcp    LISTEN  0       128         0.0.0.0:22            0.0.0.0:*          users:(("sshd",pid=900,fd=3))
tcp    LISTEN  0       4096        0.0.0.0:8080          0.0.0.0:*          users:(("docker-proxy",pid=1234,fd=4))
tcp    LISTEN  0       511         127.0.0.1:3000        0.0.0.0:*          users:(("node",pid=2222,fd=18))
udp    UNCONN  0       0           0.0.0.0:5353          0.0.0.0:*          users:(("avahi-daemon",pid=77,fd=12))
EOF
exit 0
